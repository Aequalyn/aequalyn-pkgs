# Maintainer: qempexe
pkgname=aequalyn-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Aequalyn desktop: aequalyn-* commands and default configuration"
arch=('any')
url="https://github.com/Aequalyn/aequalyn"
license=('custom')
depends=('aequalyn-shell' 'aequalyn-themes' 'hyprland' 'quickshell' 'matugen' 'awww' 'jq'
         'imagemagick' 'ffmpeg' 'brightnessctl' 'playerctl' 'ttf-jetbrains-mono-nerd')
optdepends=('mpvpaper: live (video) wallpapers')
makedepends=('git')
provides=('aequalyn')
conflicts=('aequalyn')
source=("aequalyn::git+https://github.com/Aequalyn/aequalyn.git")
sha256sums=('SKIP')

pkgver() {
    cd aequalyn
    printf '%s.r%s.%s' "$(cat VERSION)" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
    cd aequalyn
    install -d "$pkgdir/usr/share/aequalyn" "$pkgdir/usr/bin"
    cp -r bin config assets docs install.sh VERSION README.md SKILL.md "$pkgdir/usr/share/aequalyn/"
    for f in bin/*; do
        install -Dm755 "$f" "$pkgdir/usr/bin/${f##*/}"
    done
}
