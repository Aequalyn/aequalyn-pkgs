+/*
+ * Advance width of a cell, given the primary font.
+ *
+ * Monospaced: the width of any letter. Proportional: between the
+ * average and the width of 'm'; the few glyphs wider than this
+ * overflow slightly, instead of all others being spaced far apart.
+ */
+static int
+font_cell_advance(struct terminal *term, struct fcft_font *font)
+{
+    static const char32_t chars[] =
+        U"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
+
+    const struct fcft_glyph *M = fcft_rasterize_char_utf32(
+        font, U'M', term->font_subpixel);
+    const int advance = M != NULL ? M->advance.x : font->max_advance.x;
+
+    int sum = 0, count = 0, narrow = INT_MAX, wide = 0, m = advance;
+
+    for (size_t i = 0; i < ALEN(chars) - 1; i++) {
+        const struct fcft_glyph *g = fcft_rasterize_char_utf32(
+            font, chars[i], term->font_subpixel);
+        if (g == NULL)
+            continue;
+
+        sum += g->advance.x;
+        count++;
+        narrow = min(narrow, g->advance.x);
+        wide = max(wide, g->advance.x);
+        if (chars[i] == U'm')
+            m = g->advance.x;
+    }
+
+    /* Hinting may make the widths in a monospaced font differ by a pixel */
+    term->font_is_proportional = count > 0 && wide - narrow > 1;
+    if (!term->font_is_proportional)
+        return advance;
+
+    const int average = (sum + count / 2) / count;
+    return (average + m + 1) / 2;
+}
