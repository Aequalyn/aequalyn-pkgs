+/* The font lists in term->conf have been replaced */
+bool
+term_fonts_reload_from_conf(struct terminal *term)
+{
+    const struct config *conf = term->conf;
+
+    for (size_t i = 0; i < 4; i++) {
+        const struct config_font_list *font_list = &conf->fonts[i];
+
+        free(term->font_sizes[i]);
+        term->font_sizes[i] = xmalloc(
+            sizeof(term->font_sizes[i][0]) * max(font_list->count, 1));
+
+        for (size_t j = 0; j < font_list->count; j++) {
+            const struct config_font *font = &font_list->arr[j];
+            term->font_sizes[i][j] = (struct config_font){
+                .pt_size = font->pt_size, .px_size = font->px_size};
+        }
+    }
+
+    /* Not mapped yet: the new fonts are loaded when it is */
+    if (term->fonts[0] == NULL || term->shutdown.in_progress)
+        return true;
+
+    return reload_fonts(term, true);
+}
