+void
+config_fonts_replace(struct config *conf, const struct config *from)
+{
+    for (size_t i = 0; i < ALEN(conf->fonts); i++) {
+        config_font_list_destroy(&conf->fonts[i]);
+        config_font_list_clone(&conf->fonts[i], &from->fonts[i]);
+    }
+}
+
+bool
+config_fonts_equal(const struct config *a, const struct config *b)
+{
+    for (size_t i = 0; i < ALEN(a->fonts); i++) {
+        const struct config_font_list *la = &a->fonts[i];
+        const struct config_font_list *lb = &b->fonts[i];
+
+        if (la->count != lb->count)
+            return false;
+
+        for (size_t j = 0; j < la->count; j++) {
+            if (la->arr[j].pt_size != lb->arr[j].pt_size ||
+                la->arr[j].px_size != lb->arr[j].px_size ||
+                strcmp(la->arr[j].pattern, lb->arr[j].pattern) != 0)
+            {
+                return false;
+            }
+        }
+    }
+
+    return true;
+}
