+/*
+ * Reload the fonts from the configuration, in all open windows.
+ *
+ * SIGURG, since it is ignored by default: sending it to a foot
+ * without this patch is harmless.
+ */
+static bool
+fdm_sigurg(struct fdm *fdm, int signo, void *data)
+{
+    xassert(signo == SIGURG);
+
+    struct sigurg_context *ctx = data;
+
+    /* Applying overrides modifies them; use a copy */
+    config_override_t overrides = tll_init();
+    tll_foreach(*ctx->overrides, it)
+        tll_push_back(overrides, xstrdup(it->item));
+
+    user_notifications_t notifications = tll_init();
+    struct config new_conf = {NULL};
+    bool loaded = config_load(
+        &new_conf, ctx->conf->conf_path, &notifications, &overrides, false,
+        ctx->as_server);
+    tll_free_and_free(overrides, free);
+
+    if (!loaded) {
+        LOG_ERR("failed to reload the configuration, keeping current fonts");
+        config_free(&new_conf);
+        return true;
+    }
+
+    /* Fonts may have been installed since we were started */
+    if (!FcInitReinitialize())
+        LOG_WARN("failed to reinitialize fontconfig");
+
+    /* Footclients may have their own copy of the configuration. Leave
+     * those with custom fonts alone */
+    tll_foreach(ctx->wayl->terms, it) {
+        struct config *conf = (struct config *)it->item->conf;
+        if (conf != ctx->conf && config_fonts_equal(conf, ctx->conf))
+            config_fonts_replace(conf, &new_conf);
+    }
+    config_fonts_replace(ctx->conf, &new_conf);
+
+    tll_foreach(ctx->wayl->terms, it) {
+        if (config_fonts_equal(it->item->conf, &new_conf))
+            term_fonts_reload_from_conf(it->item);
+    }
+
+    config_free(&new_conf);
+    return true;
+}
